[Unit]
Description=llama.cpp server (qwen3:1.7b for klausbot)
After=network.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/home/openclaw/.local/lib
ExecStart=/home/openclaw/.local/bin/llama-server   --model /home/openclaw/models/qwen3-1.7b-q4km.gguf   --port 8080   --host 127.0.0.1   --ctx-size 16384   --threads 4   --cache-reuse 256   --jinja   --no-warmup
Restart=on-failure
RestartSec=5
StandardOutput=append:/tmp/llama-server.log
StandardError=append:/tmp/llama-server.log

[Install]
WantedBy=default.target
